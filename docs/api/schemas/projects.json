{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atman.invalid/app-v2/projects.json",
  "title": "GET /api/v1/projects",
  "description": "Every project (a project is a board) from the machine registry, the board atm ui started on first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects", "current"],
  "properties": {
    "current": {"$ref": "common.json#/$defs/slug"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "board", "repos", "source", "counts", "lead", "current"],
        "properties": {
          "slug": {"$ref": "common.json#/$defs/slug"},
          "board": {"type": "string", "minLength": 1},
          "repos": {"type": "array", "items": {"type": "string"}},
          "source": {"enum": ["started", "registry", "boards"]},
          "counts": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0},
            "description": "Ticket status counts: open, blocked, claimed, review, done. {} if the board could not be read."
          },
          "lead": {"type": "string", "description": "master.json.lead; '' when the operator has not picked one."},
          "current": {"type": "boolean"}
        }
      }
    }
  }
}
