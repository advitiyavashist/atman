@@ -0,0 +1,24 @@
+"""Summarize sales CSV files by region."""
+
+import csv
+from decimal import Decimal
+
+
+def summarize(path):
+    """Return region -> {units: int, revenue: Decimal} from a CSV path.
+
+    Input columns are region, units, and revenue. Regions retain their input
+    spelling and first-seen order. A header-only file returns an empty dict.
+    File errors and invalid numeric values propagate to the caller.
+    """
+    totals = {}
+    with open(path, newline="", encoding="utf-8") as source:
+        for row in csv.DictReader(source):
+            region = row["region"]
+            units = int(row["units"])
+            revenue = Decimal(row["revenue"])
+            if region not in totals:
+                totals[region] = {"units": 0, "revenue": Decimal("0.00")}
+            totals[region]["units"] += units
+            totals[region]["revenue"] += revenue
+    return totals
