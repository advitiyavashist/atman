+import tempfile
+import unittest
+from decimal import Decimal
+from pathlib import Path
+
+from saleskit.summary import summarize
+
+
+class SummaryTests(unittest.TestCase):
+    def test_sample_sales(self):
+        path = Path(__file__).resolve().parents[1] / "data" / "sales.csv"
+        self.assertEqual(summarize(path), {
+            "north": {"units": 15, "revenue": Decimal("600.00")},
+            "south": {"units": 7, "revenue": Decimal("315.50")},
+            "east": {"units": 21, "revenue": Decimal("987.25")},
+        })
+
+    def test_exact_revenue_and_quoted_region(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "sales.csv"
+            path.write_text(
+                'region,units,revenue\n"north, coast",1,0.10\n'
+                '"north, coast",2,0.20\n', encoding="utf-8"
+            )
+            self.assertEqual(summarize(str(path)), {
+                "north, coast": {"units": 3, "revenue": Decimal("0.30")},
+            })
+
+    def test_header_only(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "sales.csv"
+            path.write_text("region,units,revenue\n", encoding="utf-8")
+            self.assertEqual(summarize(path), {})
+
+
+if __name__ == "__main__":
+    unittest.main()

