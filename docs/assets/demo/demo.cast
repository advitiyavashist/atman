[0.028, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.0, "o", "\u001b[1;37m  Atman — your agents, one board, one handoff\u001b[0m\r\n"]
[3.003, "o", "\r\n\u001b[1;36m  Give a coordinator agent an objective. It plans the work on the board.\u001b[0m\r\n\r\n"]
[2.009, "o", "\u001b[1;32m$\u001b[0m codex exec \"$(cat $R/ceo-plan.prompt)\" --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox > $R/evidence/1-plan.log 2>&1; tail -5 $R/evidence/1-plan.log\r\n"]
[50.694, "o", "\r\n- T-001 → `codex-worker`\r\n- T-002 → `cursor-worker`\r\n\r\nStopped as requested.\r\n\u001b[1;32m$\u001b[0m atm list\r\n"]
[0.207, "o", "[ ] TO DO       T-001  Summarize regional sales  (role=backend; lane=ready; reserved: codex-worker)\r\n[ ] TO DO       T-002  Print a regional sales report  (role=backend; lane=ready; reserved: cursor-worker; BLOCKED-BY T-001)\r\n"]
[0.276, "o", "\r\n\u001b[1;36m  Two tickets, one real dependency: B waits for A.\u001b[0m\r\n\r\n"]
[4.016, "o", "\r\n\u001b[1;36m  A worker agent claims A in its own worktree, tests it, opens a PR.\u001b[0m\r\n\r\n"]
[2.012, "o", "\u001b[1;32m$\u001b[0m codex exec \"$(cat $R/codex-worker.prompt)\" --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox > $R/evidence/2-worker.log 2>&1; tail -6 $R/evidence/2-worker.log\r\n"]
