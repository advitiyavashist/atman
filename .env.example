# Local environment template. Copy to `.env` if you want a dotenv file.
# This project reads process environment variables; it does not load `.env`
# automatically. Never commit filled values.

# Board location (directory containing ticket JSON / the SQLite file)
# TICKETS_DIR=
# TICKET_BOARD_DB=

# Agent identity for CLI commands
# TICKET_AGENT=

# os.pathsep-separated absolute directories the Claude hook adapter must never
# enroll. Unset means no extra protected roots. Set to NONE to disable the
# guard after an accidental empty expansion (empty string is an error).
# TICKET_BOARD_FORBIDDEN_ROOTS=

# Fail contract tests instead of skipping when the toolchain is missing
# TICKET_BOARD_CONTRACTS_REQUIRED=1
