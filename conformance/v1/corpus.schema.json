{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atman.dev/contracts/core-conformance-corpus-v1.schema.json",
  "title": "Atman Core conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "oracle_revision", "cases"],
  "properties": {
    "contract_version": {"const": "atman-core/v1"},
    "oracle_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "area", "steps"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "area": {"type": "string", "minLength": 1},
        "driver": {"enum": ["cli", "storage-adapter"]},
        "copy": {"type": "array", "items": {"type": "object", "required": ["from", "to"]}},
        "files": {"type": "array", "items": {"type": "object", "required": ["path"]}},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string"},
              "kind": {"enum": ["command", "parallel", "write", "symlink", "bulk_plan", "measure"]},
              "argv": {"type": "array", "items": {"type": "string"}},
              "external_argv": {"type": "array", "items": {"type": "string"}},
              "agent": {"type": "string"},
              "env": {"type": "object", "additionalProperties": {"type": "string"}},
              "stdin": {"type": "string"},
              "expect": {"type": "object"},
              "capture": {"type": "object"},
              "parallel": {"type": "object"},
              "path": {"type": "string"},
              "target": {"type": "string"},
              "text": {"type": "string"},
              "directory": {"type": "boolean"},
              "count": {"type": "integer", "minimum": 1},
              "role": {"type": "string"},
              "timeout": {"type": "number", "minimum": 0.1},
              "warmup": {"type": "integer", "minimum": 0},
              "samples": {"type": "integer", "minimum": 1},
              "p95_under_ms": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
